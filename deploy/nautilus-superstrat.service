[Unit]
Description=Nautilus SuperStrat Live Trading
After=network.target
Documentation=https://github.com/nautechsystems/nautilus_trader

[Service]
Type=simple
User=gordan
Group=gordan
WorkingDirectory=/opt/nautilus
ExecStart=/opt/nautilus/.venv/bin/python examples/schwab_superstrat_live.py
Restart=on-failure
RestartSec=30

# Environment
EnvironmentFile=/opt/nautilus/.env

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nautilus-superstrat

# Auto-restart limits (prevent infinite restart loop)
StartLimitIntervalSec=300
StartLimitBurst=5

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/nautilus

[Install]
WantedBy=multi-user.target
